---
interface Props {
  appStore?: string;
  playStore?: string;
  webUrl?: string;
}

const { appStore, playStore, webUrl } = Astro.props;
---

{
  (appStore || playStore || webUrl) && (
    <div class="store-badges">
      {appStore && (
        <a class="store-badge store-badge-apple" href={appStore} target="_blank" rel="noopener noreferrer">
          <svg class="store-badge-logo" viewBox="0 0 17 20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M13.9 10.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.9-3.5.9-.7 0-1.9-.8-3.1-.8C3.9 5.4 2 6.7 1 8.7c-2 3.5-.5 8.6 1.4 11.4.9 1.4 2 2.9 3.5 2.8 1.4 0 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.4 3.3-2.8.9-1.4 1.3-2.8 1.3-2.8s-2.5-1-2.5-3.9zm-2.3-6.7c.8-.9 1.3-2.2 1.1-3.5-1.1.1-2.5.8-3.3 1.7-.7.8-1.4 2.1-1.2 3.3 1.3.1 2.6-.6 3.4-1.5z"
            />
          </svg>
          <span class="store-badge-copy">
            <span class="store-badge-brand">App Store</span>
            <span class="store-badge-sub">からダウンロード</span>
          </span>
        </a>
      )}
      {playStore && (
        <a class="store-badge store-badge-play" href={playStore} target="_blank" rel="noopener noreferrer">
          <svg class="store-badge-logo store-badge-logo-play" viewBox="0 0 20 22" aria-hidden="true">
            <path fill="#34A853" d="M1 1.4 14.2 12 1 22.6c-.7-.4-1.2-1.1-1.2-2V3.4C-.2 2.5.3 1.8 1 1.4z" />
            <path fill="#FBBC04" d="M14.9 12.6 18.4 9.4c1.1-.8 1.1-.3 0 .5l-3.5 2.7z" />
            <path fill="#EA4335" d="M1 1.4c.4-.2.8-.3 1.3-.3.5 0 1.1.2 1.6.5L16 8.8l-4.3 2.4L1 1.4z" />
            <path fill="#4285F4" d="M14.9 12.6 1 22.6c.5.3 1 .5 1.6.5.5 0 .9-.1 1.3-.3l12.3-7.1-1.3-3.1z" />
          </svg>
          <span class="store-badge-copy">
            <span class="store-badge-brand">Google Play</span>
            <span class="store-badge-sub">で手に入れよう</span>
          </span>
        </a>
      )}
      {webUrl && (
        <a class="btn btn-ghost" href={webUrl} target="_blank" rel="noopener noreferrer">
          Web
        </a>
      )}
    </div>
  )
}
