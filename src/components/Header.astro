---
import SiteName from './SiteName.astro';
import {
  t,
  localizedPath,
  worksAnchor,
  type Lang,
  stripLangPrefix,
  langCodes,
  languages,
} from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = stripLangPrefix(Astro.url.pathname);
const links = [
  { href: worksAnchor(lang), label: t(lang, 'navWorks'), match: '/#works' },
  { href: localizedPath(lang, '/blog'), label: t(lang, 'navBlog'), match: '/blog' },
  { href: localizedPath(lang, '/about'), label: t(lang, 'navAbout'), match: '/about' },
  { href: localizedPath(lang, '/contact'), label: t(lang, 'navContact'), match: '/contact' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={localizedPath(lang, '/')}><SiteName /></a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              link.match === '/#works'
                ? path === '/' || path.startsWith('/works')
                  ? 'page'
                  : undefined
                : path === link.match || path.startsWith(`${link.match}/`)
                  ? 'page'
                  : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
      <details class="lang-switch">
        <summary class="lang-switch-summary" aria-label="Language">
          <svg class="lang-globe" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path
              d="M3.5 12h17M12 3.5c2.4 2.6 3.6 5.5 3.6 8.5S14.4 17.9 12 20.5C9.6 17.9 8.4 15 8.4 12S9.6 6.1 12 3.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            ></path>
          </svg>
          <span>Language</span>
        </summary>
        <div class="lang-switch-menu" role="list">
          {
            langCodes.map((code) => (
              <a
                role="listitem"
                class={lang === code ? 'active' : undefined}
                href={localizedPath(code, path)}
                aria-current={lang === code ? 'true' : undefined}
                lang={code === 'zh' ? 'zh-Hans' : code}
              >
                {languages[code]}
              </a>
            ))
          }
        </div>
      </details>
    </nav>
  </div>
</header>
