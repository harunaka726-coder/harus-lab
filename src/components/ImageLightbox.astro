---
/** Click-to-zoom for work screenshots / body images. Does not touch content files. */
---

<dialog class="lightbox" id="image-lightbox" aria-label="Image preview">
  <button class="lightbox-close" type="button" aria-label="Close">×</button>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous">◀</button>
  <img class="lightbox-img" alt="" />
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Next">▶</button>
</dialog>

<script>
  const dialog = document.getElementById('image-lightbox') as HTMLDialogElement | null;
  const imgEl = dialog?.querySelector('.lightbox-img') as HTMLImageElement | null;
  const btnClose = dialog?.querySelector('.lightbox-close');
  const btnPrev = dialog?.querySelector('.lightbox-prev');
  const btnNext = dialog?.querySelector('.lightbox-next');
  if (dialog && imgEl) {
    const selector =
      '.shot-grid > img, article.prose p:has(> img:only-child) img';
    let sources: string[] = [];
    let index = 0;
    let touchX = 0;
    let touchY = 0;

    const collect = () =>
      Array.from(document.querySelectorAll<HTMLImageElement>(selector))
        .map((el) => el.currentSrc || el.src)
        .filter(Boolean);

    const show = (i: number) => {
      if (!sources.length) return;
      index = (i + sources.length) % sources.length;
      imgEl.src = sources[index];
      const multi = sources.length > 1;
      btnPrev?.classList.toggle('is-hidden', !multi);
      btnNext?.classList.toggle('is-hidden', !multi);
      if (!dialog.open) dialog.showModal();
    };

    document.querySelectorAll<HTMLImageElement>(selector).forEach((el, i) => {
      el.classList.add('zoomable');
      el.addEventListener('click', () => {
        sources = collect();
        const src = el.currentSrc || el.src;
        const found = sources.indexOf(src);
        show(found >= 0 ? found : i);
      });
    });

    btnClose?.addEventListener('click', () => dialog.close());
    btnPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(index - 1);
    });
    btnNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(index + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    window.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      } else if (e.key === 'Escape') {
        dialog.close();
      }
    });

    dialog.addEventListener(
      'touchstart',
      (e) => {
        const t = e.changedTouches[0];
        if (!t) return;
        touchX = t.clientX;
        touchY = t.clientY;
      },
      { passive: true },
    );

    dialog.addEventListener(
      'touchend',
      (e) => {
        if (!dialog.open || sources.length < 2) return;
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - touchX;
        const dy = t.clientY - touchY;
        if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy)) return;
        if (dx < 0) show(index + 1);
        else show(index - 1);
      },
      { passive: true },
    );
  }
</script>
