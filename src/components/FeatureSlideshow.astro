---
interface Slide {
  slug: string;
  src: string;
  href: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

{
  slides.length > 0 && (
    <div class="feature-slideshow" data-count={slides.length}>
      <div class="feature-track">
        {slides.map((slide, i) => (
          <a
            class:list={['feature-slide', { active: i === 0 }]}
            href={slide.href}
            data-index={i}
            aria-label={slide.slug}
          >
            <img src={slide.src} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
          </a>
        ))}
      </div>

      <button class="feature-nav feature-prev" type="button" aria-label="Previous">
        ◀
      </button>
      <button class="feature-nav feature-next" type="button" aria-label="Next">
        ▶
      </button>

      <div class="feature-dots" role="tablist" aria-label="Slides">
        {slides.map((_, i) => (
          <button
            class:list={['feature-dot', { active: i === 0 }]}
            type="button"
            data-index={i}
            aria-label={`Slide ${i + 1}`}
          />
        ))}
      </div>
    </div>
  )
}

<script>
  const root = document.querySelector('.feature-slideshow') as HTMLElement | null;
  if (root) {
    const slides = Array.from(root.querySelectorAll('.feature-slide'));
    const dots = Array.from(root.querySelectorAll('.feature-dot'));
    const prev = root.querySelector('.feature-prev');
    const next = root.querySelector('.feature-next');
    let i = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const colorCache = new Map<string, string>();

    /** Pick a vivid-but-readable accent from the slide (favor saturated pixels). */
    const accentFromImage = (img: HTMLImageElement): string | null => {
      if (!img.complete || img.naturalWidth === 0) return null;
      const cached = colorCache.get(img.currentSrc || img.src);
      if (cached) return cached;
      try {
        const size = 32;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        if (!ctx) return null;
        ctx.drawImage(img, 0, 0, size, size);
        const { data } = ctx.getImageData(0, 0, size, size);
        let best = { score: -1, r: 196, g: 92, b: 56 };
        let rSum = 0;
        let gSum = 0;
        let bSum = 0;
        let wSum = 0;
        for (let p = 0; p < data.length; p += 4) {
          if (data[p + 3]! < 160) continue;
          const pr = data[p]!;
          const pg = data[p + 1]!;
          const pb = data[p + 2]!;
          const max = Math.max(pr, pg, pb);
          const min = Math.min(pr, pg, pb);
          const chroma = max - min;
          if (max > 245 && min > 220) continue; // near white
          if (max < 24) continue; // near black
          const lum = 0.2126 * pr + 0.7152 * pg + 0.0722 * pb;
          // Prefer mid-tone, high-chroma pixels so the mark actually shifts per slide
          const score = chroma * 1.35 - Math.abs(lum - 120) * 0.35;
          const weight = Math.max(1, chroma);
          rSum += pr * weight;
          gSum += pg * weight;
          bSum += pb * weight;
          wSum += weight;
          if (score > best.score) best = { score, r: pr, g: pg, b: pb };
        }
        if (!wSum) return null;
        // Blend weighted average with the strongest chroma sample
        let r = Math.round((rSum / wSum) * 0.45 + best.r * 0.55);
        let g = Math.round((gSum / wSum) * 0.45 + best.g * 0.55);
        let b = Math.round((bSum / wSum) * 0.45 + best.b * 0.55);
        // Mild boost toward brand terracotta so pale slides still read as a mark
        const mix = 0.12;
        r = Math.round(r * (1 - mix) + 196 * mix);
        g = Math.round(g * (1 - mix) + 92 * mix);
        b = Math.round(b * (1 - mix) + 56 * mix);
        // Push chroma a bit so neighboring slides don't look identical
        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        if (max > min) {
          const mid = (max + min) / 2;
          const boost = 1.28;
          r = Math.round(Math.min(255, Math.max(0, mid + (r - mid) * boost)));
          g = Math.round(Math.min(255, Math.max(0, mid + (g - mid) * boost)));
          b = Math.round(Math.min(255, Math.max(0, mid + (b - mid) * boost)));
        }
        const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
        if (lum > 165) {
          const t = (lum - 165) / 90;
          r = Math.round(r * (1 - 0.4 * t));
          g = Math.round(g * (1 - 0.4 * t));
          b = Math.round(b * (1 - 0.4 * t));
        } else if (lum < 55) {
          const t = (55 - lum) / 55;
          r = Math.round(r + (255 - r) * 0.32 * t);
          g = Math.round(g + (255 - g) * 0.32 * t);
          b = Math.round(b + (255 - b) * 0.32 * t);
        }
        const color = `rgb(${r}, ${g}, ${b})`;
        colorCache.set(img.currentSrc || img.src, color);
        return color;
      } catch {
        return null;
      }
    };

    const syncBrandMark = () => {
      const img = slides[i]?.querySelector('img') as HTMLImageElement | null;
      if (!img) return;
      const apply = () => {
        const color = accentFromImage(img);
        if (color) document.documentElement.style.setProperty('--brand-mark', color);
      };
      if (img.complete) apply();
      else img.addEventListener('load', apply, { once: true });
    };

    const show = (nextIndex: number) => {
      slides[i]?.classList.remove('active');
      dots[i]?.classList.remove('active');
      i = (nextIndex + slides.length) % slides.length;
      slides[i]?.classList.add('active');
      dots[i]?.classList.add('active');
      syncBrandMark();
    };

    const restart = () => {
      if (timer) clearInterval(timer);
      if (slides.length > 1) {
        timer = setInterval(() => show(i + 1), 4200);
      }
    };

    prev?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      show(i - 1);
      restart();
    });
    next?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      show(i + 1);
      restart();
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const idx = Number((dot as HTMLElement).dataset.index || 0);
        show(idx);
        restart();
      });
    });

    root.addEventListener('mouseenter', () => {
      if (timer) clearInterval(timer);
    });
    root.addEventListener('mouseleave', () => restart());

    syncBrandMark();
    restart();
  }
</script>
