---
interface Slide {
  slug: string;
  src: string;
  href: string;
  mark?: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const firstHref = slides[0]?.href ?? '#';
---

{
  slides.length > 0 && (
    <div class="feature-slideshow" data-count={slides.length}>
      <div class="feature-track">
        {slides.map((slide, i) => (
          <div
            class:list={['feature-slide', { active: i === 0 }]}
            data-index={i}
            data-mark={slide.mark}
            data-href={slide.href}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <img src={slide.src} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>

      <button class="feature-hit feature-hit-prev" type="button" aria-label="Previous">
        <span class="feature-hit-label" aria-hidden="true">◀</span>
      </button>
      <a class="feature-hit feature-hit-center" href={firstHref} aria-label="Open work"></a>
      <button class="feature-hit feature-hit-next" type="button" aria-label="Next">
        <span class="feature-hit-label" aria-hidden="true">▶</span>
      </button>

      <div class="feature-dots" role="tablist" aria-label="Slides">
        {slides.map((_, i) => (
          <button
            class:list={['feature-dot', { active: i === 0 }]}
            type="button"
            data-index={i}
            aria-label={`Slide ${i + 1}`}
          />
        ))}
      </div>
    </div>
  )
}

<script>
  const root = document.querySelector('.feature-slideshow') as HTMLElement | null;
  if (root) {
    const slides = Array.from(root.querySelectorAll('.feature-slide'));
    const dots = Array.from(root.querySelectorAll('.feature-dot'));
    const prev = root.querySelector('.feature-hit-prev');
    const next = root.querySelector('.feature-hit-next');
    const center = root.querySelector('.feature-hit-center') as HTMLAnchorElement | null;
    let i = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const syncBrandMark = () => {
      const mark = (slides[i] as HTMLElement | undefined)?.dataset.mark;
      if (mark) document.documentElement.style.setProperty('--brand-mark', mark);
    };

    const syncCenterLink = () => {
      const href = (slides[i] as HTMLElement | undefined)?.dataset.href;
      if (center && href) center.href = href;
    };

    const show = (nextIndex: number) => {
      slides[i]?.classList.remove('active');
      slides[i]?.setAttribute('aria-hidden', 'true');
      dots[i]?.classList.remove('active');
      i = (nextIndex + slides.length) % slides.length;
      slides[i]?.classList.add('active');
      slides[i]?.setAttribute('aria-hidden', 'false');
      dots[i]?.classList.add('active');
      syncBrandMark();
      syncCenterLink();
    };

    const restart = () => {
      if (timer) clearInterval(timer);
      if (slides.length > 1) {
        timer = setInterval(() => show(i + 1), 4200);
      }
    };

    prev?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      show(i - 1);
      restart();
    });
    next?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      show(i + 1);
      restart();
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const idx = Number((dot as HTMLElement).dataset.index || 0);
        show(idx);
        restart();
      });
    });

    root.addEventListener('mouseenter', () => {
      if (timer) clearInterval(timer);
    });
    root.addEventListener('mouseleave', () => restart());

    syncBrandMark();
    syncCenterLink();
    restart();
  }
</script>
