---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, localizedPath, type Lang } from '../../i18n/ui';

const lang: Lang = 'zh';
---

<BaseLayout lang={lang} title={t(lang, 'aboutTitle')}>
  <section class="section wrap fade-in prose">
    <h1 class="page-title">{t(lang, 'aboutTitle')}</h1>
    <p class="page-lead">Haru's Lab</p>
    <p>
      Haru's Lab 是一个小实验室，围绕有趣的点子、实用应用和轻量实验，做手机 App 与网页服务。
    </p>
    <p>
      作品放在 Works。长文会发在 Blog，也会写在
      <a href="https://note.com/nice_acacia5247" target="_blank" rel="noopener noreferrer">Note</a>。
      运营者姓名只出现在页脚署名里。
    </p>
    <div class="cta-row">
      <a class="btn" href={localizedPath(lang, '/')}>{t(lang, 'navHome')}</a>
      <a class="btn btn-ghost" href={localizedPath(lang, '/contact')}>{t(lang, 'navContact')}</a>
    </div>
  </section>
</BaseLayout>
