---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoreBadges from '../../../components/StoreBadges.astro';
import WorkPager from '../../../components/WorkPager.astro';
import { t, localizedPath, type Lang } from '../../../i18n/ui';
import {
  getWorksSorted,
  getWorkNeighbors,
  workTitle,
  workSummary,
  workPathId,
  workIcon,
  workScreenshots,
  resolveImageColumns,
  categoryLabel,
} from '../../../lib/works';
import { renderMarkdocHtml } from '../../../lib/markdocHtml';
import { loadWorkContentLocale } from '../../../lib/workContentLocale';
import { render } from 'astro:content';

const lang: Lang = 'en';

export async function getStaticPaths() {
  const works = await getWorksSorted();
  return works.map((work) => ({
    params: { slug: workPathId(work) },
    props: { work },
  }));
}

const { work } = Astro.props;
const shots = workScreenshots(work, lang);
const cols = resolveImageColumns(work, shots.length);
const { prev, next } = await getWorkNeighbors(work);
const slug = workPathId(work);
const localeSource = loadWorkContentLocale(slug, lang, work.data.contentEn);
const localeHtml = renderMarkdocHtml(localeSource);
const useLocaleBody = Boolean(localeHtml);
const { Content } = useLocaleBody ? { Content: null } : await render(work);
---

<BaseLayout lang={lang} title={workTitle(work, lang)} description={workSummary(work, lang)}>
  <article class={`section wrap fade-in prose prose-cols-${cols}`}>
    <div class="detail-hero">
      <img class="detail-icon" src={workIcon(work)} alt="" width="120" height="120" />
      <div>
        <p class="rule-meta">{categoryLabel(lang, work.data.category)}</p>
        <h1 class="page-title">{workTitle(work, lang)}</h1>
        <p class="page-lead">{workSummary(work, lang)}</p>
        <p>
          <strong>{t(lang, 'platforms')}</strong>
          {work.data.platforms.join(' / ')}
        </p>
        <StoreBadges
          appStore={work.data.appStore}
          playStore={work.data.playStore}
          webUrl={work.data.webUrl}
        />
      </div>
    </div>

    <WorkPager lang={lang} prev={prev} next={next} />

    {useLocaleBody ? <div set:html={localeHtml} /> : Content && <Content />}

    {
      shots.length > 0 && (
        <div class={`shot-grid shot-cols-${cols}`}>
          {shots.map((src) =>
            work.data.webUrl ? (
              <a href={work.data.webUrl} target="_blank" rel="noopener noreferrer">
                <img src={src} alt="" loading="lazy" />
              </a>
            ) : (
              <img src={src} alt="" loading="lazy" />
            ),
          )}
        </div>
      )
    }

    <WorkPager lang={lang} prev={prev} next={next} />
    <div class="work-links">
      <a class="btn btn-ghost" href={localizedPath(lang, '/')}>{t(lang, 'navHome')}</a>
    </div>
  </article>
</BaseLayout>
