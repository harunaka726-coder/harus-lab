---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, localizedPath, type Lang } from '../../i18n/ui';
import { getPostsSorted, postTitle, postExcerpt, postPathId } from '../../lib/blog';
import { render } from 'astro:content';

const lang: Lang = 'ja';

export async function getStaticPaths() {
  const posts = await getPostsSorted();
  return posts.map((post) => ({
    params: { slug: postPathId(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout lang={lang} title={postTitle(post, lang)} description={postExcerpt(post, lang)}>
  <article class="section wrap fade-in prose">
    <p class="rule-meta">{post.data.date.toISOString().slice(0, 10)}</p>
    <h1 class="page-title">{postTitle(post, lang)}</h1>
    <p class="page-lead">{postExcerpt(post, lang)}</p>
    <Content />
    {
      post.data.noteUrl && (
        <p>
          <a href={post.data.noteUrl} target="_blank" rel="noopener noreferrer">
            {t(lang, 'noteCredit')}
          </a>
        </p>
      )
    }
    <p><a href={localizedPath(lang, '/blog')}>{t(lang, 'allPosts')}</a></p>
  </article>
</BaseLayout>
