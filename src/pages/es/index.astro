---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteName from '../../components/SiteName.astro';
import FeatureSlideshow from '../../components/FeatureSlideshow.astro';
import { t, localizedPath, type Lang } from '../../i18n/ui';
import {
  getFeaturedWorks,
  getOtherWorks,
  workTitle,
  workSummary,
  workPathId,
  workIcon,
} from '../../lib/works';
import { getFeatureSlidesForSlugs } from '../../lib/featureSlides';
import { getPostsSorted, postTitle, postExcerpt, postPathId } from '../../lib/blog';

const lang: Lang = 'es';
const featured = await getFeaturedWorks();
const others = await getOtherWorks();
const posts = (await getPostsSorted()).slice(0, 3);
const slides = getFeatureSlidesForSlugs(featured.map((w) => workPathId(w))).map((slide) => ({
  ...slide,
  href: localizedPath(lang, `/works/${slide.slug}`),
}));
---

<BaseLayout lang={lang} description={t(lang, 'tagline')}>
  <section class="hero wrap fade-in">
    <div class="hero-stage">
      <div class="hero-copy">
        <p class="hero-kicker">{t(lang, 'heroKicker')}</p>
        <SiteName as="h1" class="hero-title" />
      </div>
      <FeatureSlideshow slides={slides} />
    </div>
  </section>

  <section class="section" id="works">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="section-title">{t(lang, 'featuredWorks')}</h2>
      </div>
      <div class="app-gallery">
        {
          featured.map((work) => (
            <a class="app-tile reveal" href={localizedPath(lang, `/works/${workPathId(work)}`)}>
              <img class="app-icon" src={workIcon(work)} alt="" width="100" height="100" />
              <div>
                <h3 class="app-tile-title">{workTitle(work, lang)}</h3>
                <p class="app-tile-meta">{workSummary(work, lang)}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="section-title">{t(lang, 'othersWorks')}</h2>
      </div>
      <ul class="others-list">
        {
          others.map((work) => (
            <li>
              <a class="others-item reveal" href={localizedPath(lang, `/works/${workPathId(work)}`)}>
                <span class="others-item-main">
                  <img class="others-icon" src={workIcon(work)} alt="" width="36" height="36" />
                  {workTitle(work, lang)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="section-title">{t(lang, 'latestBlog')}</h2>
        <a href={localizedPath(lang, '/blog')}>{t(lang, 'allPosts')}</a>
      </div>
      <ul class="rule-list">
        {
          posts.map((post) => (
            <li>
              <a class="rule-item reveal" href={localizedPath(lang, `/blog/${postPathId(post)}`)}>
                <span class="rule-meta">{post.data.date.toISOString().slice(0, 10)}</span>
                <div>
                  <h3 class="rule-title">{postTitle(post, lang)}</h3>
                  <p class="rule-summary">{postExcerpt(post, lang)}</p>
                </div>
                <span class="rule-meta">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
